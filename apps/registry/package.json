{
  "name": "identity-research-cloudflare",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "dev": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "build:client": "tsc -p tsconfig.client.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
