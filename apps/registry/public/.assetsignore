# Serve only intentional root-level web assets. Git ignore does not control uploads.
**/*
!/*.html
!/*.css
!/*.js
!/*.json
!/analysis.py
!/research_package.py
# Explicit generated gallery only; no source bundles or Python packages.
!/explorers/
!/explorers/rel_*/
!/explorers/index.html
!/explorers/index.json
!/explorers/build-manifest.json
!/explorers/rel_*/index.html
!/explorers/rel_*/contrasts.svg
!/explorers/rel_*/explorer.css
!/explorers/rel_*/explorer.js
!/explorers/rel_*/view-manifest.json
!/robots.txt
!/sitemap.xml
!/llms.txt

# Unmodified self-hosted Basteleur and its required license; no broad font-directory upload.
!/fonts/
!/fonts/Basteleur-Bold.woff2
!/fonts/Basteleur-Moonlight.woff2
!/fonts/Basteleur-OFL.txt
