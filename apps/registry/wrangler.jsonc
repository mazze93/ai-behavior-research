{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "a478cd1da11cbde86fb26a63697c34e0",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "identity-research-registry",
      "database_id": "f6ea5c0d-5c13-4e9f-a4a2-2a05d1ffbaeb",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "identity-research-evidence"
    }
  ],
  "version_metadata": {
    "binding": "VERSION"
  },
  "name": "identity-research-web",
  "main": "src/web.ts",
  "build": {
    "command": "PYTHONDONTWRITEBYTECODE=1 python3 ../../scripts/check_explorer_gallery.py && PYTHONDONTWRITEBYTECODE=1 python3 ../../scripts/stage_landing.py --verify-public"
  },
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "identity-research-jobs"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://research.mazzeleczzare.com",
    "ALLOWED_MODELS": "@cf/meta/llama-3.1-8b-instruct-fp8",
    "GATEWAY_ID": "identity-research"
  },
  "routes": [
    {
      "pattern": "research.mazzeleczzare.com",
      "custom_domain": true
    }
  ]
}
