---
import { Font } from 'astro:assets';
import StudyRoom from '../components/StudyRoom';
import ResearchIndex, { groups } from '../components/ResearchIndex';
import '../styles/landing.css';
export interface Props {}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Research / Mazze LeCzzare</title>
    <meta name="description" content="Experiments on what models say, how behavior changes, and what the record actually supports. Study-specific instruments and public evidence." />
    <link rel="canonical" href="https://research.mazzeleczzare.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Research / Mazze LeCzzare" />
    <meta property="og:description" content="Question. Record. Reconsider. Working instruments for observable model behavior." />
    <meta property="og:url" content="https://research.mazzeleczzare.com/" />
    <meta name="twitter:card" content="summary" />
    <Font cssVariable="--font-poster" preload />
    <Font cssVariable="--font-reading" preload />
  </head>
  <body>
    <a class="skip" href="#main">Skip to research</a>
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="Mazze LeCzzare Research home">MAZZE LECZZARE<span>RESEARCH</span></a>
      <nav aria-label="Main">
        <a href="#studies">Studies <span class="nav-arrow" aria-hidden="true">↙</span></a>
        <a href="#evidence">Evidence <span class="nav-arrow" aria-hidden="true">↙</span></a>
        <a href="/prepare.html" aria-label="Analysis & writing"><span class="nav-wide">Analysis & writing</span><span class="nav-compact" aria-hidden="true">Analysis</span><span class="nav-arrow" aria-hidden="true">↗</span></a>
        <a href="/console.html" aria-label="Private console"><span class="nav-wide">Private console</span><span class="nav-compact" aria-hidden="true">Console</span><span class="nav-arrow" aria-hidden="true">↗</span></a>
      </nav>
      <ResearchIndex client:load />
    </header>
    <main id="main">
      <div class="edition"><span>An inquiry in progress</span><span>Public evidence / Private controls</span><span>Independent research · 2026</span></div>
      <StudyRoom id="research-fold" client:idle />
      <section class="evidence-section" id="evidence" aria-labelledby="evidence-title">
        <div class="section-label"><span>Evidence / Reviewed public releases</span><a href="/method.html">Standards & limitations ↗</a></div>
        <div class="evidence-intro"><h2 id="evidence-title">The record<br />comes first.</h2><div><p>Each release carries its methods, failures and limits. A smoke test verifies machinery; it is not a completed research pilot. A hash identifies bytes; it does not certify a claim.</p><a class="text-link" href="/prepare.html#share-title">Share and cite the evidence <span aria-hidden="true">↗</span></a></div></div>
        <div id="notification" role="status"></div>
        <div id="releases" class="release-list" aria-live="polite"><p>Reviewed releases are available from the <a href="/api/releases">public registry</a>.</p></div>
        <noscript><p>The release list needs JavaScript. <a href="/api/releases">Read the public JSON index</a>.</p></noscript>
      </section>
      <section class="research-directory" id="research-directory" aria-labelledby="directory-title">
        <h2 id="directory-title">Research directory</h2>
        <div class="directory-links">{Object.values(groups).flat().map(entry => <a href={entry.href}>{entry.title} ↗</a>)}</div>
      </section>
      <footer><span>Mazze LeCzzare Frazer / Independent research</span><a href="/ethics.html">Research ethics</a><a href="/method-audit.html">Method audit</a><a href="#main">Back to the question ↑</a></footer>
    </main>
    <script src="../scripts/releases.ts"></script>
  </body>
</html>
