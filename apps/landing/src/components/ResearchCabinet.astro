---
import InstrumentVisual from './InstrumentVisual.astro';
export interface Props {}
const instruments = [
 { id:'identity',number:'01',kind:'study',name:'Identity Dissolution',short:'Identity',state:'Technical smoke evidence',question:'What happens when a model is asked to keep describing itself?',method:'Controlled generation / Factorial prompts',measure:'Self-reference · repetition · recovery',description:'Compare prompt conditions while retaining the complete sequence: what was requested, what came back, what failed, and what changed.',steps:['Freeze the prompt conditions and execution budget.','Generate bounded turn sequences through the research Gateway.','Inspect raw calls, exclusions and recovery alongside the metrics.'],limit:'The public smoke releases establish technical execution only. They do not demonstrate identity loss or a behavioral effect.',href:'/studies/identity-dissolution',action:'Enter the instrument',source:'/method.html',sourceLabel:'Protocol & provenance' },
 { id:'persona',number:'02',kind:'study',name:'Persona Integrity',short:'Persona',state:'Local scoring instrument',question:'When does a performance become an asserted self-description?',method:'Contextual reading / Categorical annotation',measure:'Framing · assertion · uncertainty',description:'Read marked fiction, unmarked simulation and asserted self-description in their actual context. Keep the excerpt, competing reading and your uncertainty together.',steps:['Bring a source packet with its provenance.','Annotate each response with evidence and an alternative reading.','Export a journal; resume without replacing the original record.'],limit:'Solo annotation represents one reader. Delayed re-scoring can examine within-rater consistency; it cannot establish independent agreement.',href:'/studies/persona-integrity',action:'Open the study',source:'/persona.html',sourceLabel:'Owner scoring studio' },
 { id:'authority',number:'03',kind:'study',name:'Authority Without Assertion',short:'Authority',state:'Protocol in development',question:'What crosses a session boundary when no authority is asserted?',method:'Session handoff / Constraint tracing',measure:'Principal constraint · inherited state · next action',description:'Track a proposition across a handoff, keeping the inherited constraint and the next action visible rather than inferring intent from tone alone.',steps:['Retain the principal constraint before the handoff.','Separate inherited state from a new assertion.','Inspect the next action against the study-specific rubric.'],limit:'The protocol is not frozen and a hosted trial instrument is not available. Canonical sources require repository access; this brief is not a result.',href:'https://github.com/mazze93/Research/tree/main/authority-without-assertion',action:'Canonical study source ↗',source:'#methods',sourceLabel:'Study-specific methods' },
 { id:'bearing',number:'04',kind:'tool',name:'Bearing',short:'Bearing',state:'Rust core / In development',question:'What still holds when part of a claim’s framing is removed?',method:'Claim graph / Dependency inspection',measure:'Claims · support · counterfactual removal',description:'Trace a claim to its support, inspect dependencies, and examine what remains when a framing element is removed. Keep the distinction between a coherent record and a true claim.',steps:['Preserve the source of each represented claim.','Inspect dependencies and the selected read-point.','Compare a frame-removal result with its source interpretation.'],limit:'The Rust core is a bounded port, not the full engine. A graph projection is not independent verification or a truth score.',href:'https://github.com/mazze93/Research',action:'Canonical tool source ↗',source:'/method-audit.html',sourceLabel:'Selected public method audit' },
] as const;
---
<section class="cabinet-intro" aria-labelledby="hero-title">
  <div class="intro-heading"><p class="eyebrow">Independent AI behavior research / Working index 2026</p><h1 id="hero-title">A field<br/>of inquiry<span class="title-stop">.</span></h1></div>
  <div class="intro-note"><p class="editorial">Follow the question.<br/>Stay with the evidence.</p><p>Study-specific instruments for observable model behavior. Open a brief, compare a method, inspect a record. Keep the interpretation in reach.</p><div class="intro-status"><span><i class="status-dot"></i> Public evidence</span><span>Private execution</span></div></div>
  <div class="intro-foot"><span>Read / unfold / trace</span><span>Illustrations are not findings. Status and limits travel with every instrument.</span></div>
</section>
<nav class="cabinet-trail" aria-label="Research location"><a href="#main">Research <span class="crumb-mark" aria-hidden="true">◧</span></a><span aria-hidden="true">/</span><a href="#instruments">Instruments <span class="crumb-mark" aria-hidden="true">▧</span></a><span aria-hidden="true">/</span><span id="trail-current">The working field</span><a class="trail-record" href="#evidence">Follow the record <span aria-hidden="true">↘</span></a></nav>
<section class="instruments-section" id="instruments" aria-labelledby="instruments-title">
  <header class="cabinet-section-head"><h2 id="instruments-title"><span>01</span> Working instruments</h2><p>03 studies / 01 reusable tool</p></header>
  <div class="cabinet-toolbar"><div class="filter-group" role="group" aria-label="Filter instruments"><button type="button" data-filter="all" aria-pressed="true">All instruments <span>04</span></button><button type="button" data-filter="study" aria-pressed="false">Studies <span>03</span></button><button type="button" data-filter="tool" aria-pressed="false">Tools <span>01</span></button></div><label class="cabinet-search"><span>Find</span><input type="search" id="instrument-search" placeholder="a question, method, instrument…" aria-label="Search instruments" /></label><button type="button" id="expand-briefs" aria-pressed="false">Unfold all <span aria-hidden="true">↙</span></button></div>
  <p class="cabinet-no-results" id="instrument-empty" role="status" hidden>No matching instrument. Clear the search or choose All instruments.</p>
  <div class="instrument-grid">
    {instruments.map(item=><details class={`instrument-card card-${item.id}`} id={item.id} data-kind={item.kind} data-title={item.name}>
      <summary>
        <div class="card-topline"><span class="card-number">{item.number}</span><span class="card-category">{item.kind} / {item.short}</span><span class="card-state">{item.state}</span></div>
        <h3>{item.name}</h3>
        <div class="card-question"><span class="micro-label">The question</span><p>{item.question}</p></div>
        <figure class="card-specimen" aria-hidden="true"><InstrumentVisual kind={item.id}/></figure><p class="specimen-label">Illustration / non-data</p>
        <div class="card-bottomline"><span>{item.method}</span><span class="unfold-label">Read the brief <b aria-hidden="true">＋</b></span></div>
      </summary>
      <div class="card-brief">
        <div class="brief-route"><a href="#instruments">Research</a><span>/</span><span>{item.kind}</span><span>/</span><strong>{item.short}</strong><span>/</span><span>Method & limits</span></div>
        <div class="brief-columns"><div><p class="micro-label">What you can do here</p><p class="brief-description">{item.description}</p><ol>{item.steps.map(step=><li>{step}</li>)}</ol></div><aside><p class="micro-label">What is examined</p><p class="brief-measure">{item.measure}</p><p class="micro-label">Interpretation boundary</p><p class="brief-limit">{item.limit}</p></aside></div>
        <div class="brief-actions"><a href={item.href}>{item.action}<span aria-hidden="true">↗</span></a><a href={item.source}>{item.sourceLabel}<span aria-hidden="true">↗</span></a></div>
      </div>
    </details>)}
  </div>
  <p class="cabinet-instruction">Open more than one brief to compare methods. Hover or focus a card to uncover its specimen. Every instrument keeps its own rubric.</p>
</section>
